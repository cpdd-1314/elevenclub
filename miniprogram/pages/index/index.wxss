page {
  height: 100%;
  background: #f7f5fa;
  color: #30283b;
  font-size: 28rpx;
}

.page-scroll {
  height: 100vh;
  width: 100%;
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}

.hero {
  padding: 36rpx 20rpx;
  border-radius: 24rpx;
  background: #eee3fa;
  text-align: center;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: bold;
}

.hero-subtitle {
  font-size: 24rpx;
  color: #776982;
  margin-top: 12rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  color: #776982;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.tab.active {
  background: #7651a8;
  color: #fff;
  font-weight: bold;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 22rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 31rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.sub-title {
  font-size: 27rpx;
  font-weight: bold;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
}

.hint {
  color: #887f91;
  font-size: 24rpx;
  line-height: 1.7;
  margin: 8rpx 0;
}

.batch-input {
  width: 100%;
  height: 360rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #e8e0f0;
  border-radius: 14rpx;
  background: #fcfbfe;
  font-size: 26rpx;
  line-height: 1.7;
  margin-top: 20rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: bold;
  margin: 22rpx 0 10rpx;
}

.text-input {
  width: 100%;
  height: 84rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: #fcfbfe;
  border: 2rpx solid #e8e0f0;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.primary-btn {
  background: #7651a8;
  color: #fff;
  border-radius: 14rpx;
  font-size: 29rpx;
  margin-top: 20rpx;
}

.primary-btn::after {
  border: none;
}

.message-card {
  background: #eee7fa;
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 20rpx;
  color: #5f4287;
  line-height: 1.6;
}

.data-line {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 13rpx 0;
  border-bottom: 1rpx solid #f1edf5;
}

.data-line text:last-child {
  text-align: right;
  overflow-wrap: anywhere;
}

.amount {
  color: #7651a8;
  font-weight: bold;
}

.allocation-line {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #eee7f4;
}

.warning {
  color: #a44335;
  background: #fff1ed;
  padding: 16rpx;
  border-radius: 12rpx;
  line-height: 1.7;
  margin-top: 18rpx;
}

.status-ok {
  color: #248354;
  margin-top: 14rpx;
  font-size: 24rpx;
}

.order-item,
.staff-item {
  padding: 20rpx 0;
  border-top: 1rpx solid #eee8f3;
}

.order-top {
  display: flex;
  justify-content: space-between;
  font-size: 29rpx;
  font-weight: bold;
}

.staff-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.staff-info {
  flex: 1;
}

.staff-name {
  font-size: 31rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.delete-btn {
  margin: 16rpx 0 0;
  background: #fff0f0;
  color: #b34b55;
  font-size: 23rpx;
  border-radius: 12rpx;
}

.delete-btn::after {
  border: none;
}

.summary-cell {
  background: #f7f2fc;
  padding: 20rpx;
  border-radius: 14rpx;
  margin-top: 14rpx;
}

.summary-label {
  color: #83768e;
  font-size: 23rpx;
  margin-bottom: 12rpx;
}

.summary-value {
  font-size: 30rpx;
  font-weight: bold;
}

.highlight {
  color: #7651a8;
}

.empty {
  color: #958a9f;
  text-align: center;
  padding: 36rpx 12rpx;
}

.footer {
  color: #a196ad;
  font-size: 22rpx;
  text-align: center;
  padding: 20rpx 0;
}